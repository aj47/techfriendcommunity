# Frontend
VITE_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud

# Backend env vars are set with `npx convex env set NAME value`:
#   BRIDGE_SECRET            shared with the Discord bot bridge
#   FIRECRAWL_API_KEY        Firecrawl component
#   FIRECRAWL_WEBHOOK_SECRET Firecrawl crawl webhooks (optional)
#   AGENTMAIL_API_KEY        AgentMail component
#   AGENTMAIL_WEBHOOK_SECRET AgentMail inbound webhooks
#   AUTH_GITHUB_ID / AUTH_GITHUB_SECRET   GitHub OAuth app (Convex Auth)
#   AUTH_RESEND_KEY          Resend key for magic-link sign-in
#   SITE_URL                 public site URL used in auth redirects
